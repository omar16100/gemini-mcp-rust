# Gemini API Configuration
GEMINI_API_KEY=your_api_key_here

# Optional: Override default models
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_FLASH_MODEL=gemini-3.8-flash

# Optional: retries after the first attempt for transient errors (0-10, 0 disables)
# GEMINI_MAX_RETRIES=3

# Optional: gemini-search-v2 response cache (0 disables either)
# GEMINI_CACHE_TTL_SECS=300
# GEMINI_CACHE_MAX_ENTRIES=100

# Logging is controlled with the --verbose / --quiet CLI flags.
